{
  "active_aut": "automationexercise",
  "aut_registry": {
    "automationexercise": {
      "name": "Automation Exercise",
      "base_url": "https://automationexercise.com"
    },
    "tutorialsninja": {
      "name": "TutorialsNinja Demo",
      "base_url": "https://tutorialsninja.com/demo"
    },
    "opencart": {
      "name": "OpenCart Official Demo",
      "base_url": "https://demo.opencart.com"
    }
  },
  "browser": {
    "default": "chrome",
    "supported": ["chrome", "firefox"],
    "headless": false,
    "window_size": {
      "width": 1920,
      "height": 1080
    }
  },
  "timeouts": {
    "explicit_wait_seconds": 15,
    "page_load_seconds": 30,
    "script_timeout_seconds": 20,
    "poll_frequency_seconds": 0.5
  },
  "data_source": "excel",
  "logging": {
    "level": "INFO",
    "max_file_size_mb": 10,
    "backup_count": 5
  }
}
